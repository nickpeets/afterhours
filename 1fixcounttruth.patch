+/* ============================================================================
+   roomCounts — HEADCOUNT TRUTH.
+   The one and only headcount derivation.  Every number the app shows about
+   who is in a room — lobby card, room header, line watchbar, bench slice —
+   reads from here; no call site derives its own count.  Input is the member
+   shape the room renders from (active_members: fresh <60s OR role='kept',
+   never 'gone').  The locks live HERE, once, never at call sites:
+     · the host has no membership row by design — "people in the room"
+       includes her (+1 on total)
+     · benched members (role 'line') count toward total AND line — the old
+       watchbar arithmetic subtracted the three benched men from their own
+       line count, which is the "0 in line while people are benched" bug
+     · staleness cannot inflate a count even from a raw table read: the
+       active_members freshness rule is re-applied defensively
+   ========================================================================= */
+function roomCounts(members, room){
+  const nowMs=(typeof serverNow==="function")?serverNow():Date.now();
+  const isFresh=(m)=>{
+    if(m.role==="kept") return true;              // a kept man is on stage; staleness doesn't unseat him
+    if(!m.last_seen) return true;                 // no beat recorded yet: a brand-new row is present
+    const t=Date.parse(m.last_seen);
+    return !t || (nowMs-t)<60000;
+  };
+  const rows=(members||[]).filter(m=>m
+    && m.role!=="gone"
+    && (!room || !room.host_id || m.user_id!==room.host_id)
+    && isFresh(m));
+  const line=rows.filter(m=>m.role==="line");
+  return {
+    crowd:  rows.filter(m=>m.role==="spectator").length,
+    line:   line.length,
+    bench:  Math.min(3,line.length),
+    chairs: rows.filter(m=>m.role==="chair").length,
+    kept:   rows.filter(m=>m.role==="kept").length,
+    total:  rows.length+1
+  };
+}
